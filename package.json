    "seed": "ts-node prisma/seeds/index.ts",
    "seed:cities": "ts-node prisma/seeds/add_city_unaccent_name.ts",
    "generate:i18n-types": "ts-node ./src/i18n/generate-i18n-types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.614.0",
