{
  "name": "centerlight-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node ./dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node prisma/seeds/index.ts",
    "seed:cities": "ts-node prisma/seeds/add_city_unaccent_name.ts",
    "generate:i18n-types": "ts-node ./src/i18n/generate-i18n-types.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.9",
    "@nestjs/core": "^10.3.9",
    "@nestjs/devtools-integration": "^0.1.6",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.3.9",
    "@nestjs/schedule": "^4.0.2",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "8.1.1",
    "@types/glob": "^8.1.0",
    "apple-signin-auth": "^1.7.6",
    "bcryptjs": "^2.4.3",
    "cache-manager": "6.3.2",
    "cheerio": "^1.0.0-rc.12",
    "csv": "^6.3.10",
    "fs-extra": "^11.2.0",
    "glob": "11.0.1",
    "html-entities": "^2.5.2",
    "jest-mock-extended": "^3.0.7",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "moment": "^2.30.1",
    "nest-winston": "^1.10.0",
    "nestjs-i18n": "^10.4.5",
    "nodemailer": "^6.9.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "webpack": "^5.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/config": "^3.2.2",
    "@nestjs/microservices": "^10.3.9",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.9",
    "@prisma/client": "6.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "22.10.6",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "17.15.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "7.2.1",
    "jest": "^29.7.0",
    "nestjs-devtools-loader": "^1.1.1",
    "prettier": "^3.3.2",
    "prisma": "^5.15.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.4.5"
  },
  "resolutions": {
    "glob": "^9.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^prisma/(.*)$": "<rootDir>/prisma/$1",
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  }
}
